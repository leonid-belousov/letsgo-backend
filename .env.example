# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
# Matches docker-compose.yml (local development only)
DATABASE_URL=postgresql://letsgo:letsgo_local_password@localhost:5432/letsgo?schema=public
# Comma-separated list of allowed browser origins (web client dev server)
CORS_ORIGINS=http://localhost:5173
# Replace with a long random value; must be >= 32 chars
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-32chars
LOG_LEVEL=info
# --- Auth / sessions ---
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# scrypt cost N = 2^value (OWASP minimum is 17; lower only for tests)
PASSWORD_SCRYPT_LOG_N=16
PASSWORD_MIN_LENGTH=8
# --- Google / Apple sign-in (optional; a provider with an empty list answers 503 PROVIDER_NOT_CONFIGURED) ---
# Comma-separated accepted ID-token audiences: Google OAuth client ids (web/android/ios); Apple bundle id / service id
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# --- Product switches (see OPEN_DECISIONS.md) ---
# Casual game without a club: EXPLICIT_ONLY (organiser must grant event.cash.confirm) or ORGANISER
CASUAL_CASH_RECEIVER_POLICY=EXPLICIT_ONLY
WAITLIST_OFFER_MINUTES=30
MVP_VOTING_HOURS=24
RATING_EDIT_DAYS=7
IDEMPOTENCY_TTL_HOURS=48
# Local dev media storage (production provider is OPEN)
MEDIA_LOCAL_DIR=./.media

# Persistent maintenance job (0 = disabled; run `npm run maintenance:tick` from a scheduler)
MAINTENANCE_INTERVAL_SECONDS=30
NOTIFICATION_MAX_ATTEMPTS=5
# false | hop count (1) | subnet list (loopback,10.0.0.0/8). 'true' is refused.
TRUST_PROXY=false
# Max connections in this instance's PostgreSQL pool
DB_POOL_MAX=10
