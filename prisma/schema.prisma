// Let'sGo — Prisma schema (single owner: lead architect).
// Conventions: UUIDv7 ids, timestamptz(3) UTC, money = integer minor units + currency,
// `version` on editable resources (optimistic concurrency). Invariants Prisma cannot
// express (exclusion constraints, immutability triggers, partial uniques, case checks)
// live in prisma/migrations/*_invariants/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

